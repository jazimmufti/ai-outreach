{
  "manifest_version": 3,
  "name": "Arclent Outreach Assistant",
  "version": "1.2.1",
  "description": "Automates opening creator DMs and populating outreach messages across Instagram, X (Twitter), Discord, and Facebook for Arclent collaboration verification.",
  "browser_specific_settings": {
    "gecko": {
      "id": "arclent-assistant@arclent.com",
      "strict_min_version": "109.0"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://instagram.com/*",
    "https://*.x.com/*",
    "https://x.com/*",
    "https://*.twitter.com/*",
    "https://twitter.com/*",
    "https://*.discord.com/*",
    "https://discord.com/*",
    "https://*.facebook.com/*",
    "https://facebook.com/*",
    "https://*.messenger.com/*",
    "https://messenger.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.arclent.com/*",
    "https://arclent.com/*",
    "https://*.up.railway.app/*",
    "https://ai-outreach-production-8dcc.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arclent Outreach Assistant",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://instagram.com/*",
        "https://*.x.com/*",
        "https://x.com/*",
        "https://*.twitter.com/*",
        "https://twitter.com/*",
        "https://*.discord.com/*",
        "https://discord.com/*",
        "https://*.facebook.com/*",
        "https://facebook.com/*",
        "https://*.messenger.com/*",
        "https://messenger.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.arclent.com/*",
        "https://arclent.com/*",
        "https://*.up.railway.app/*",
        "https://ai-outreach-production-8dcc.up.railway.app/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*.arclent.com/*",
      "https://arclent.com/*",
      "https://*.up.railway.app/*",
      "https://ai-outreach-production-8dcc.up.railway.app/*"
    ]
  }
}
