# ==============================================================================
# CREATOR OUTREACH ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Google Gemini API Key (Required for intelligent entity resolution and email classification)
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# YouTube Data API v3 Key (Optional: Falls back automatically to oEmbed + Public Scraper if omitted)
# Enable at: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=

# Google OAuth 2.0 Web Application Credentials (Required for Gmail sending)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Ensure Authorized Redirect URI includes: http://localhost:8000/api/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/gmail/callback

# Session Secret Key for OAuth State Verification (Generate any random secure string)
SESSION_SECRET_KEY=change_this_to_a_random_secure_secret_key_32_chars_or_more

# Application Environment (development / production)
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
